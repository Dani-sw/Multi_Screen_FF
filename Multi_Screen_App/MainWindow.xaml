<Window x:Class="Multi_Screen_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Multi_Screen_App"
        Title="Multi Screen Manager"
        Width="1050"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#101216"
        Foreground="#E8EAF0"
        ResizeMode="CanResize" Loaded="Window_Loaded" WindowStyle="None">


    <!-- ========================================================= -->
    <!-- RESOURCES                                                  -->
    <!-- ========================================================= -->

    <Window.Resources>


        <!-- COLORS -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#101216"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#171A20"/>

        <SolidColorBrush x:Key="PanelLightBrush"
                         Color="#1D2129"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#292E38"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#E8EAF0"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#8E96A5"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#00A8FF"/>


        <!-- ===================================================== -->
        <!-- CHECKBOX                                                -->
        <!-- ===================================================== -->

        <Style x:Key="ModernCheckBox"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="#3B414D"
                                    Background="#15181E">

                                <Path x:Name="Check"
                                      Data="M 4,10 L 8,14 L 16,5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <ControlTemplate.Triggers>


                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Box"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>

                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>

                                <Setter TargetName="Check"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>


                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Box"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>

                            </Trigger>


                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX                                               -->
        <!-- ===================================================== -->

        <Style x:Key="ModernComboBox"
       TargetType="ComboBox">

            <Setter Property="Foreground"
            Value="#E8EAF0"/>

            <Setter Property="Background"
            Value="#20242C"/>

            <Setter Property="BorderBrush"
            Value="#363D49"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="FontSize"
            Value="12"/>

            <Setter Property="Height"
            Value="38"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- ================================================= -->
                            <!-- MAIN BOX                                           -->
                            <!-- ================================================= -->

                            <Border x:Name="MainBorder"
                            Background="#20242C"
                            BorderBrush="#363D49"
                            BorderThickness="1"
                            CornerRadius="6">

                                <Grid>

                                    <!-- SELECTED ITEM -->

                                    <ContentPresenter
                                Margin="12,0,35,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="#E8EAF0"/>


                                    <!-- ARROW -->

                                    <TextBlock Text="▼"
                                       FontSize="8"
                                       Foreground="#737C8B"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                                </Grid>

                            </Border>


                            <!-- ================================================= -->
                            <!-- CLICK AREA                                          -->
                            <!-- ================================================= -->

                            <ToggleButton x:Name="DropDownButton"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen,
                                      RelativeSource={RelativeSource TemplatedParent},
                                      Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="Transparent"
                                        CornerRadius="6"/>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>


                            <!-- ================================================= -->
                            <!-- POPUP                                               -->
                            <!-- ================================================= -->

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">

                                <Border Background="#1A1E25"
                                BorderBrush="#363D49"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">

                                    <ScrollViewer MaxHeight="250"
                                          VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- COMBOBOX ITEMS                                     -->
                        <!-- ================================================= -->

                        <ControlTemplate.Resources>

                            <Style TargetType="ComboBoxItem">

                                <Setter Property="Foreground"
                                Value="#E8EAF0"/>

                                <Setter Property="Background"
                                Value="Transparent"/>

                                <Setter Property="Padding"
                                Value="10,8"/>

                                <Setter Property="HorizontalContentAlignment"
                                Value="Left"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ComboBoxItem">

                                            <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">

                                                <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="#E8EAF0"/>

                                            </Border>


                                            <ControlTemplate.Triggers>

                                                <!-- HOVER -->

                                                <Trigger Property="IsMouseOver"
                                                 Value="True">

                                                    <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#252C36"/>

                                                </Trigger>


                                                <!-- SELECTED -->

                                                <Trigger Property="IsSelected"
                                                 Value="True">

                                                    <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#007FBF"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ControlTemplate.Resources>


                        <!-- ================================================= -->
                        <!-- STATES                                             -->
                        <!-- ================================================= -->

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="MainBorder"
                                Property="BorderBrush"
                                Value="#00A8FF"/>

                            </Trigger>


                            <Trigger Property="IsDropDownOpen"
                             Value="True">

                                <Setter TargetName="MainBorder"
                                Property="BorderBrush"
                                Value="#00A8FF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- ADD BUTTON                                               -->
        <!-- ===================================================== -->

        <Style x:Key="AddButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="18,11">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- LIST ITEM                                                -->
        <!-- ===================================================== -->

        <Style x:Key="ApplicationListBoxItem"
               TargetType="ListBoxItem">

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="Row"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,14">

                            <ContentPresenter/>

                        </Border>


                        <ControlTemplate.Triggers>


                            <!-- SELECTED -->

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="Row"
                                        Property="Background"
                                        Value="#1C2732"/>

                                <Setter TargetName="Row"
                                        Property="BorderBrush"
                                        Value="#007FBF"/>

                            </Trigger>


                            <!-- MOUSE OVER -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Row"
                                        Property="Background"
                                        Value="#1B1F27"/>

                            </Trigger>


                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- TITLE BAR BUTTON                                         -->
        <!-- ===================================================== -->

        <Style x:Key="TitleBarButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="45"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="#8E96A5"/>

            <Setter Property="Cursor"
                    Value="Hand"/>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#252A33"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- CLOSE BUTTON -->

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButton}">

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#C42B3C"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN                                                       -->
    <!-- ========================================================= -->

    <Grid>


        <Grid.RowDefinitions>

            <RowDefinition Height="30"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CUSTOM TITLE BAR                                        -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#171A20"
                BorderBrush="#242832"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">


            <Grid>


                <!-- TITLE -->

                <TextBlock Text="Multi Screen Manager"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#9BA3B0"
                           FontSize="11"/>


                <!-- WINDOW BUTTONS -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">


                    <!-- MINIMIZE -->

                    <Button Content="—"
                            Style="{StaticResource TitleBarButton}"
                            Click="Minimize_Click"
                            FontSize="14"/>


                    <!-- MAXIMIZE -->

                    <Button Content="□"
                            Style="{StaticResource TitleBarButton}"
                            Click="Maximize_Click"
                            FontSize="13"/>


                    <!-- CLOSE -->

                    <Button Content="✕"
                            Style="{StaticResource CloseButton}"
                            Click="Close_Click"
                            FontSize="12"/>


                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- APPLICATION AREA                                       -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="230"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- SIDEBAR                                             -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#14171C"
                    BorderBrush="#242832"
                    BorderThickness="0,0,1,0">


                <Grid Margin="22">


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- LOGO -->

                    <StackPanel>


                        <TextBlock Text="MULTI"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="White"/>


                        <TextBlock Text="SCREEN MANAGER"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#687180"
                                   Margin="2,0,0,0"/>

                    </StackPanel>


                    <!-- MENU -->

                    <StackPanel Grid.Row="1"
                                Margin="0,45,0,0">


                        <Border Background="#1C2732"
                                CornerRadius="8"
                                Padding="14,12">


                            <StackPanel Orientation="Horizontal">


                                <TextBlock Text="▦"
                                           FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>


                                <TextBlock Text="Applications"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>


                            </StackPanel>

                        </Border>

                    </StackPanel>


                    <!-- VERSION -->

                    <TextBlock Grid.Row="2"
                               Text="v1.0.0"
                               Foreground="#505764"
                               FontSize="11"/>


                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN CONTENT                                       -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Margin="32">


                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ============================================= -->
                <!-- HEADER                                          -->
                <!-- ============================================= -->

                <Grid>


                    <!-- TITLE -->

                    <StackPanel>


                        <TextBlock Text="Applications"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#F2F4F8"/>


                        <TextBlock Text="Manage applications and their monitor configuration"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>


                    </StackPanel>


                    <!-- ADD -->

                    <Button HorizontalAlignment="Right"
                            Content="+   ADD APPLICATION"
                            Style="{StaticResource AddButton}"
                            Click="AddApplication_Click"/>


                </Grid>


                <!-- ============================================= -->
                <!-- COLUMN HEADERS                                  -->
                <!-- ============================================= -->

                <Border Grid.Row="1"
                        Margin="0,30,0,10"
                        Padding="18,8">


                    <Grid>


                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="120"/>

                            <ColumnDefinition Width="150"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Text="APPLICATION"
                                   Foreground="#606876"
                                   FontSize="10"
                                   FontWeight="Bold"/>


                        <TextBlock Grid.Column="1"
                                   Text="STARTUP"
                                   Foreground="#606876"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>


                        <TextBlock Grid.Column="2"
                                   Text="MONITOR"
                                   Foreground="#606876"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>


                    </Grid>

                </Border>

                <!-- ============================================= -->
                <!-- APPLICATION LIST                                -->
                <!-- ============================================= -->

                <Grid Grid.Row="2">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="60"/>

                    </Grid.RowDefinitions>


                    <!-- ============================================= -->
                    <!-- LIST                                            -->
                    <!-- ============================================= -->

                    <ListBox x:Name="ApplicationsList"
             Grid.Row="0"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ItemContainerStyle="{StaticResource ApplicationListBoxItem}">


                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="120"/>

                                        <ColumnDefinition Width="150"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- APPLICATION -->

                                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                                        <Border Width="42"
                                Height="42"
                                CornerRadius="9"
                                Background="#222731">

                                            <TextBlock Text="EXE"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                        </Border>


                                        <StackPanel Margin="14,0,0,0"
                                    VerticalAlignment="Center">

                                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E8EAF0"/>

                                            <TextBlock Text="{Binding Path}"
                                       Foreground="#646C79"
                                       FontSize="10"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>

                                    </StackPanel>


                                    <!-- STARTUP -->

                                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding Startup}"
                              HorizontalAlignment="Center"/>


                                    <!-- MONITOR -->

                                    <ComboBox Grid.Column="2"
                              Width="150"
                              Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Source={x:Static local:Preferences.Monitors}}"
                              SelectedValuePath="Index"
                              SelectedValue="{Binding Monitor, Mode=TwoWay}">

                                        <ComboBox.ItemTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding Name}"
                                           Foreground="#E8EAF0"
                                           FontSize="12"/>

                                            </DataTemplate>

                                        </ComboBox.ItemTemplate>

                                    </ComboBox>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>


                    <!-- ============================================= -->
                    <!-- SAVE BUTTON                                     -->
                    <!-- ============================================= -->

                    <Button x:Name="Save_Btn" Grid.Row="1"
                        Width="130"
                        Height="38"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="✓   SAVE"
                        Style="{StaticResource AddButton}"/>

                </Grid>

            </Grid>


        </Grid>


    </Grid>

</Window>