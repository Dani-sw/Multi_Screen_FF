<Window x:Class="Multi_Screen_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Multi_Screen_App"
        Title="Multi Screen Manager"
        Width="1050"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#07101F"
        Foreground="#F4F7FF"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        WindowStyle="None"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- MODERN DARK PALETTE / BRUSHES                              -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#07101F"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#091426"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0D1A2D"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#11233C"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1A3555"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8193B2"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#566984"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#12B8FF"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#176BFF"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16C9FF" Offset="0"/>
            <GradientStop Color="#087DFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101F" Offset="0"/>
            <GradientStop Color="#0A1629" Offset="0.55"/>
            <GradientStop Color="#06101F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10213A" Offset="0"/>
            <GradientStop Color="#0B172A" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="22"
                          ShadowDepth="0"
                          Opacity="0.35"
                          Color="#000000"/>

        <DropShadowEffect x:Key="GlowShadow"
                          BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.55"
                          Color="#008DFF"/>

        <!-- ========================================================= -->
        <!-- CHECKBOX                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="30" Height="30">
                            <Border x:Name="Box"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#345071"
                                    Background="#0A1526"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 6,14 L 11,19 L 22,8"
                                      Stroke="White"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#35D2FF"/>
                                <Setter TargetName="Box" Property="Effect" Value="{StaticResource GlowShadow}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#12B8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- COMBOBOX                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="Background" Value="#11233C"/>
            <Setter Property="BorderBrush" Value="#294666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <ContentPresenter Margin="42,0,38,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="#F4F7FF"/>

                                    <!-- Monitor icon -->
                                    <Border Width="22"
                                            Height="16"
                                            Margin="14,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#8DA8CB"
                                            BorderThickness="2"
                                            CornerRadius="2">
                                        <Border Width="8"
                                                Height="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,-4,0,0"
                                                Background="#8DA8CB"/>
                                    </Border>

                                    <TextBlock Text="⌄"
                                               FontSize="16"
                                               Foreground="#8DA8CB"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,1"/>
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="DropDownButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="12"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#0C192B"
                                        BorderBrush="#294666"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="5"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Effect="{StaticResource SoftShadow}">
                                    <ScrollViewer MaxHeight="250"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="#F4F7FF"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="#F4F7FF"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#153456"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#087DFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ControlTemplate.Resources>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#12B8FF"/>
                                <Setter TargetName="MainBorder" Property="Background" Value="#142944"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#12B8FF"/>
                                <Setter TargetName="MainBorder" Property="Effect" Value="{StaticResource GlowShadow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- PRIMARY BUTTON                                             -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{StaticResource GlowShadow}"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- APPLICATION LIST ITEM                                      -->
        <!-- ========================================================= -->

        <Style x:Key="ApplicationListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="{StaticResource CardGradient}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="3"
                                CornerRadius="16"
                                Padding="16"
                                Effect="{StaticResource SoftShadow}">
                            <Grid>
                                <!-- Accent rail -->
                                <Border x:Name="AccentRail"
                                        Width="4"
                                        CornerRadius="3"
                                        Background="{StaticResource AccentGradient}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"/>
                                <ContentPresenter Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#112844"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#1A78C5"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#27557D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- TITLE BAR BUTTONS                                          -->
        <!-- ========================================================= -->

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#91A4C0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14243A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D53D58"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ============================================================= -->
    <!-- WINDOW                                                         -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource WindowGradient}">

        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- CUSTOM TITLE BAR                                            -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="#07111F"
                BorderBrush="#17304E"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">

                    <Border Width="20"
                            Height="20"
                            CornerRadius="5"
                            Background="{StaticResource AccentGradient}"
                            Effect="{StaticResource GlowShadow}">
                        <Grid>
                            <Border Width="10"
                                    Height="10"
                                    BorderBrush="White"
                                    BorderThickness="1.5"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="Title_lbl" Text="Multi Screen APP Manager"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#DDE8F8"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="—"
                            Style="{StaticResource TitleBarButton}"
                            Click="Minimize_Click"/>

                    <Button Content="□"
                            Style="{StaticResource TitleBarButton}"
                            Click="Maximize_Click"/>

                    <Button Content="×"
                            Style="{StaticResource CloseButton}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- APPLICATION AREA                                           -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================== -->
            <!-- SIDEBAR                                                 -->
            <!-- ===================================================== -->

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="#17304E"
                    BorderThickness="0,0,1,0">

                <Grid Margin="22">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO -->
                    <StackPanel>

                        <Grid Width="205"
                              Height="100"
                              HorizontalAlignment="Center" Margin="0,0,-0.2,0" >

                            <Border Width="80"
                                    Height="80"
                                    CornerRadius="11"
                                    BorderBrush="#11BFFF"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="25,0,100,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#102A48" Offset="0"/>
                                        <GradientStop Color="#0B1B31" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Width="80"
                                    Height="80"
                                    CornerRadius="11"
                                    BorderBrush="#705BFF"
                                    BorderThickness="2"
                                    Margin="73,20,52,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.9"/>
                        </Grid>


                    </StackPanel>

                    <!-- MENU -->
                    <StackPanel Grid.Row="1"
                                Margin="0,48,0,0">

                        <Border Background="#102A49"
                                BorderBrush="#175A8E"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="14,13"
                                Effect="{StaticResource SoftShadow}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 4-square icon -->
                                <Grid Width="22" Height="22">
                                    <UniformGrid Rows="2" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Margin="2" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                        <Border Margin="2" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                        <Border Margin="2" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                        <Border Margin="2" CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                                    </UniformGrid>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Text="Applications"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#F4F7FF"/>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="25"
                                           Foreground="#35BFFF"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- VERSION -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <Ellipse Width="20"
                                 Height="20"
                                 Fill="#11D8C4"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="version_lbl" Text="v1.0.0.0"
                                   Foreground="White"
                                   FontSize="14"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- MAIN CONTENT                                             -->
            <!-- ===================================================== -->

            <Grid Grid.Column="1"
                  Margin="34,28,34,28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Decorative glow -->


                <!-- HEADER -->
                <Grid>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="54"
                                    Height="54"
                                    CornerRadius="16"
                                    Background="#0D2541"
                                    BorderBrush="#1D6FA9"
                                    BorderThickness="1"
                                    Margin="0,0,16,0">
                                <Grid>
                                    <UniformGrid Rows="2" Columns="2"
                                                 Width="28"
                                                 Height="28"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                        <Border Margin="2" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                                        <Border Margin="2" CornerRadius="3" Background="#72B7FF"/>
                                        <Border Margin="2" CornerRadius="3" Background="#72B7FF"/>
                                        <Border Margin="2" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Applications"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="#F7FAFF"/>

                                <TextBlock Text="Manage applications and their monitor configuration"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="13"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="+   ADD APPLICATION"
                            Style="{StaticResource PrimaryButton}"
                            Height="48"
                            MinWidth="190"
                            Click="AddApplication_Click"/>
                </Grid>

                <!-- ========================================================= -->
                <!-- COLUMN HEADERS -->
                <!-- ========================================================= -->
                <Border Grid.Row="1" Margin="0,28,0,10" Padding="18,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="171.2"/>
                            <ColumnDefinition Width="163.2"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <!-- APPLICATION -->
                        <TextBlock Text="APPLICATION" Foreground="#58718F" FontSize="10" FontWeight="Bold" Grid.ColumnSpan="2" Margin="0,0,123.8,-0.4"/>
                        <!-- STARTUP -->
                        <TextBlock Text="LAUNCH WHEN THIS APP STARTS"  Foreground="#58718F" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Grid.ColumnSpan="2" Margin="5.4,0,153,-0.4" Width="176" Grid.Column="1"/>
                        <!-- MONITOR -->
                        <TextBlock Grid.Column="2" Text="MONITOR" Foreground="#58718F" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="58.2,0,57,-0.4" Width="48"/>
                        <!-- DELETE -->
                        <!-- Nessun titolo volutamente -->
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- APPLICATION LIST -->
                <!-- ========================================================= -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="62"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ApplicationsList" Grid.Row="0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource ApplicationListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="50">
                                    <!-- ================================================= -->
                                    <!-- COLUMNS -->
                                    <!-- ================================================= -->
                                    <Grid.ColumnDefinitions>
                                        <!-- Application -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Startup -->
                                        <ColumnDefinition Width="110"/>
                                        <!-- Monitor -->
                                        <ColumnDefinition Width="190"/>
                                        <!-- Delete -->
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ================================================= -->
                                    <!-- APPLICATION -->
                                    <!-- ================================================= -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="14" Background="#122B4A" BorderBrush="#24537D" BorderThickness="3">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.2" Color="#008DFF"/>
                                            </Border.Effect>
                                            <TextBlock Text="EXE" Foreground="#17C1FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F4F7FF"/>
                                            <TextBlock Text="{Binding Path}" Foreground="#7085A2" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- ================================================= -->
                                    <!-- STARTUP -->
                                    <!-- ================================================= -->
                                    <CheckBox Grid.Column="1" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding Startup}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- ================================================= -->
                                    <!-- MONITOR -->
                                    <!-- ================================================= -->
                                    <ComboBox Grid.Column="2" Width="180" Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Source={x:Static local:Preferences.Monitors}}" SelectedValuePath="Index" SelectedValue="{Binding Monitor, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#F4F7FF" FontSize="13"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- ================================================= -->
                                    <!-- DELETE / REMOVE -->
                                    <!-- ================================================= -->
                                    <Button Grid.Column="3" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Remove application" Click="Remove_Application_btn">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DeleteBorder" Width="38" Height="38" CornerRadius="10" Background="Transparent">
                                                    <!-- X ICON -->
                                                    <Path x:Name="DeleteIcon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#7186A3" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,3 L 13,13 M 13,3 L 3,13"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- HOVER -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DeleteBorder" Property="Background" Value="#351923"/>
                                                        <Setter TargetName="DeleteIcon" Property="Stroke" Value="#FF526D"/>
                                                    </Trigger>
                                                    <!-- PRESSED -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="DeleteBorder" Property="Background" Value="#521B2A"/>
                                                        <Setter TargetName="DeleteIcon" Property="Stroke" Value="#FF304F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="1">

                        <!-- AVVISO -->
                        <TextBlock x:Name="Warning_lbl"
               Text="⚠  Unsaved changes"
               Foreground="#FF526D"
               FontSize="16"
               FontWeight="SemiBold"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Visibility="Collapsed"/>

                        <!-- SAVE BUTTON -->
                        <Button x:Name="Save_Btn"
            Width="145"
            Height="46"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="✓ SAVE"
            Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</Window>
